#
# CS2 and MISO pins apply only to Plasticlogic.com epaper displays
#
# default:
CONFIG_EINK_SPI_CS2=4
# default:
CONFIG_EINK_SPI_MISO=19

#
# Config below applies to 4 epaper module wave12I48 w/4 SPI CS & BUSY pins (14 pins)
#

#
# | S2 | M2 |
#

#
# -----------
#

#
# | M1 | S1 |
#
